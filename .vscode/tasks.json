{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        // Build tasks
        {
            "label": "build",
            "detail": "Build workspace (default)",
            "type": "shell",
            "command": ". /ros_ws/.devcontainer/scripts/build.sh",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "build selected package",
            "detail": "Build a specific ros 2 package from the workspace",
            "type": "shell",
            "command": "colcon",
            "args": [
                "build",
                "--packages-select",
                "${input:packageName}",
                "--symlink-install",
                "--merge-install",
                "--cmake-args",
                "-DCMAKE_BUILD_TYPE=${env:DEFAULT_CMAKE_BUILD_TYPE}",
                "-DCMAKE_EXPORT_COMPILE_COMMANDS=On",
                "-DTEST_INTEGRATION=On"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": "$gcc"            
        },
        {
            "label": "debug",
            "detail": "Build workspace (debug)",
            "type": "shell",
            "command": ". /ros_ws/.devcontainer/scripts/build.sh",
            "options": {
                "env": {
                    "BUILD_TYPE": "Debug"
                }
            },
            "group": "build",
            "problemMatcher": "$gcc"
        },
        // Test tasks
        {
            "label": "test",
            "detail": "Run all unit tests and show results.",
            "type": "shell",
            "command": ". /ros_ws/.devcontainer/scripts/test.sh",
            "group": {
                "kind": "test",
                "isDefault": true
            }
        },
        // Clean
        {
            "label": "clean",
            "detail": "Run the clean target",
            "type": "shell",
            "command": "colcon build --cmake-target clean",
            "problemMatcher": "$gcc"
        },
        {
            "label": "purge",
            "detail": "Purge workspace by deleting all generated files.",
            "type": "shell",
            "command": "sudo rm -fr build install log; sudo py3clean .",
            "problemMatcher": []
        },
        {
            "label": "source",
            "detail": "Source workspace",
            "type": "shell",
            "command": "source /opt/ros/jazzy/setup.bash",
            "problemMatcher": []
        },
        // Linting and static code analysis tasks
        {
            "label": "uncrustify format package",
            "detail": "Reformat all cpp files in a package with uncrustify.",
            "type": "shell",
            "command": "ament_uncrustify",
            "args": [
                "--reformat",
                "src/${input:packageName}"
            ],
            "problemMatcher": []
        },
        {
            "label": "uncrustify format file",
            "detail": "Reformat the current cpp file with uncrustify.",
            "type": "shell",
            "command": "ament_uncrustify",
            "args": [
                "--reformat",
                "${relativeFile}"
            ],
            "problemMatcher": []
        },
        {
            "label": "uncrustify package",
            "detail": "Lint all cpp files in package with uncrustify.",
            "type": "shell",
            "command": "ament_uncrustify",
            "args": [
                "src/${input:packageName}"
            ],
            "presentation": {
                "panel": "dedicated",
                "reveal": "silent",
                "clear": true
            },
            "problemMatcher": [
                {
                    "owner": "uncrustify",
                    "source": "uncrustify",
                    "fileLocation": "relative",
                    "pattern": [
                        // just the file name message
                        {
                            "regexp": "^(.*)'(.*)':",
                            "kind": "file",
                            "file": 2,
                            "message": 1
                        }
                    ]
                }
            ]
        },
        {
            "label": "uncrustify file",
            "detail": "Lint the current cpp file with uncrustify.",
            "type": "shell",
            "command": "ament_uncrustify",
            "args": [
                "${relativeFile}"
            ],
            "presentation": {
                "panel": "dedicated",
                "reveal": "silent",
                "clear": true
            },
            "problemMatcher": [
                {
                    "owner": "uncrustify",
                    "source": "uncrustify",
                    "fileLocation": "relative",
                    "pattern": [
                        // just the file name message
                        {
                            "regexp": "^(.*)'(.*)':",
                            "kind": "file",
                            "file": 2,
                            "message": 1
                        }
                    ]
                }
            ]
        },
        {
            "label": "cpplint package",
            "detail": "Lint files with cpplint in a package.",
            "type": "ament",
            "task": "cpplint",
            "path": "src/${input:packageName}",
            "problemMatcher": "$ament_cpplint",
            "presentation": {
                "panel": "dedicated",
                "reveal": "silent",
                "clear": true
            },
        },
        {
            "label": "cpplint file",
            "detail": "Lint the current file with cpplint.",
            "type": "ament",
            "task": "cpplint",
            "path": "${relativeFile}",
            "problemMatcher": "$ament_cpplint",
            "presentation": {
                "panel": "dedicated",
                "reveal": "silent",
                "clear": true
            },
        },
        {
            "label": "cppcheck package",
            "detail": "Run static code checker with cppcheck in a package.",
            "type": "ament",
            "task": "cppcheck",
            "path": "src/${input:packageName}",
            "problemMatcher": "$ament_cppcheck",
            "presentation": {
                "panel": "dedicated",
                "reveal": "silent",
                "clear": true
            },
            "options": {
                "env": {
                    "AMENT_CPPCHECK_ALLOW_SLOW_VERSIONS": "1"
                }
            }
        },
        {
            "label": "cppcheck file",
            "detail": "Run static code checker with cppcheck on the current file.",
            "type": "ament",
            "task": "cppcheck",
            "path": "${relativeFile}",
            "problemMatcher": "$ament_cppcheck",
            "presentation": {
                "panel": "dedicated",
                "reveal": "silent",
                "clear": true
            },
            "options": {
                "env": {
                    "AMENT_CPPCHECK_ALLOW_SLOW_VERSIONS": "1"
                }
            }
        },
        {
            "label": "lint_cmake package",
            "detail": "Run lint on cmake files in a package.",
            "type": "ament",
            "task": "lint_cmake",
            "path": "src/${input:packageName}",
            "problemMatcher": "$ament_lint_cmake",
            "presentation": {
                "panel": "dedicated",
                "reveal": "silent",
                "clear": true
            }
        },
        {
            "label": "flake8 package",
            "detail": "Run flake8 on python files in a package.",
            "type": "ament",
            "task": "flake8",
            "path": "src/${input:packageName}",
            "problemMatcher": "$ament_flake8",
            "presentation": {
                "panel": "dedicated",
                "reveal": "silent",
                "clear": true
            }
        },
        {
            "label": "flake8 file",
            "detail": "Run flake8 on the current python file.",
            "type": "ament",
            "task": "flake8",
            "path": "${relativeFile}",
            "problemMatcher": "$ament_flake8",
            "presentation": {
                "panel": "dedicated",
                "reveal": "silent",
                "clear": true
            }
        },
        {
            "label": "pep257 package",
            "detail": "Run pep257 on python files in a package.",
            "type": "ament",
            "task": "pep257",
            "path": "src/${input:packageName}",
            "problemMatcher": "$ament_pep257",
            "presentation": {
                "panel": "dedicated",
                "reveal": "silent",
                "clear": true
            }
        },
        {
            "label": "pep257 file",
            "detail": "Run pep257 on the current python file.",
            "type": "ament",
            "task": "pep257",
            "path": "${relativeFile}",
            "problemMatcher": "$ament_pep257",
            "presentation": {
                "panel": "dedicated",
                "reveal": "silent",
                "clear": true
            }
        },
        {
            "label": "xmllint package",
            "detail": "Run xmllint on xml files.",
            "type": "ament",
            "task": "xmllint",
            "path": "src/${input:packageName}",
            "problemMatcher": "$ament_xmllint",
            "presentation": {
                "panel": "dedicated",
                "reveal": "silent",
                "clear": true
            }
        },
        {
            "label": "lint package",
            "detail": "Run all linters on package.",
            "dependsOn": [
                "cppcheck package",
                "cpplint package",
                "flake8 package",
                "lint_cmake package",
                "pep257 package",
                "xmllint package",
                "uncrustify package"
            ],
            "problemMatcher": []
        },
        // Workspace editing tasks
        {
            "label": "new ament_cmake package",
            "detail": "Create a new ROS cpp package from a template.",
            "type": "shell",
            "command": "ros2 pkg create --destination-directory src --build-type ament_cmake ${input:newPackageName}",
            "problemMatcher": []
        },
        {
            "label": "new ament_python package",
            "detail": "Create a new ROS python package from a template.",
            "type": "shell",
            "command": "ros2 pkg create --destination-directory src --build-type ament_python ${input:newPackageName}",
            "problemMatcher": []
        },
        {
            "label": "import from workspace file",
            "detail": "Use vcs to import modules specified by a workspace/rosinstall file.",
            "type": "shell",
            "command": "vcs import < src/ros2.repos src",
            "problemMatcher": []
        },
        {
            "label": "update workspace file",
            "detail": "Use vcs to update repositories in src to workspace file.",
            "type": "shell",
            "command": "vcs export src > src/ros2.repos",
            "problemMatcher": []
        },
        {
            "label": "install dependencies",
            "detail": "Install all dependencies specified in the workspaces package.xml files.",
            "type": "shell",
            "command": "sudo apt-get update && rosdep update && rosdep install --from-paths src --ignore-src -y",
            "problemMatcher": []
        },
        {
            "label": "setup",
            "detail": "Set up the workspace",
            "type": "shell",
            "command": ". /ros_ws/.devcontainer/scripts/setup.sh",
            "problemMatcher": []
        },
        {
            "label": "add submodules from .repos",
            "detail": "Create a git submodule for all repositories in your .repos file",
            "type": "shell",
            "command": "python3 .devcontainer/scripts/repos_to_submodules.py",
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "newPackageName",
            "type": "promptString",
            "description": "Enter the name of the new package to create",
            "default": "my_new_package"
        },
        {
            "id": "packageName",
            "type": "pickString",
            "description": "Select a package",
            "options": [
                "my_package",
            ],
            "default": "my_package"
        }
    ]
}