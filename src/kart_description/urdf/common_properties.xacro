<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
    <!-- Define common Inertial Properties Macros -->

    <!--
        Here we are taking into accounts only rotations around the Z-axis,
        which passes through the center of mass of the rigid body
    -->

    <!-- BOX -->
    <xacro:macro name="box_inertia" params="m x y z o_xyz o_rpy">
        <inertial>
            <mass value="${m}"/>
            <origin xyz="${o_xyz}" o_rpy="${o_rpy}"/>
            <inertia ixx="${m * (y * y + z * z) / 12.0}" ixy="0" ixz="0"
                     iyy="${m * (x * x + z * z) / 12.0}" iyz="0"
                     izz="${m * (x * x + y * y) / 12.0}"/>
        </inertial>
    </xacro:macro>

    <!-- CYLINDER -->
    <xacro:macro name="cylinder_inertia" params="m r h o_xyz o_rpy">
        <inertial>
            <mass value="${m}"/>
            <origin xyz="${o_xyz}" o_rpy="${o_rpy}"/>
            <inertia ixx="${m * (3.0 * r * r + h * h) / 12.0}" ixy="0" ixz="0"
                     iyy="${m * (3.0 * r * r + h * h) / 12.0}" iyz="0"
                     izz="${m * r * r / 2.0}"/>
        </inertial>
    </xacro:macro>

    <!-- SPHERE -->
    <xacro:macro name="sphere_inertia" params="m r o_xyz o_rpy">
        <inertial>
            <mass value="${m}"/>
            <origin xyz="${o_xyz}" o_rpy="${o_rpy}"/>
            <inertia ixx="${m * 2.0 / 5.0 * r * r}" ixy="0" ixz="0"
                     iyy="${m * 2.0 / 5.0 * r * r}" iyz="0"
                     izz="${m * 2.0 / 5.0 * r * r}"/>
        </inertial>
    </xacro:macro>

</robot>